# Django Settings
SECRET_KEY=django-insecure-prod-key-ticket-booking-platform-2026-secure!
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration (PostgreSQL in production, SQLite fallback for development)
# DATABASE_URL=postgres://postgres:password@localhost:5432/ticket_booking_db
USE_SQLITE=True

# JWT Configuration
JWT_SECRET_KEY=jwt-secret-key-online-ticket-system-2026
JWT_ACCESS_LIFETIME_MINUTES=60
JWT_REFRESH_LIFETIME_DAYS=7

# CORS Allowed Origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Payment Gateways (Leave empty or test keys in development)
STRIPE_PUBLIC_KEY=pk_test_placeholder_key
STRIPE_SECRET_KEY=sk_test_placeholder_key
STRIPE_WEBHOOK_SECRET=whsec_test_placeholder

PAYPAL_CLIENT_ID=paypal_test_client_id
